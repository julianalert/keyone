# ============================================================
# key.one — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ---- Supabase -----------------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Keep secret — server-side only

# ---- Stripe -------------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...       # Use sk_test_ in development
STRIPE_WEBHOOK_SECRET=whsec_...     # From Stripe webhook endpoint settings
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...  # Use pk_test_ in development

# ---- Upstash Redis (rate limiting) -------------------------
# Get these from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=Axx...

# ---- Inngest (background jobs) -----------------------------
# Get these from: https://app.inngest.com
INNGEST_SIGNING_KEY=signkey-...
INNGEST_EVENT_KEY=eventkey-...

# ---- Resend (transactional email) --------------------------
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# ---- External API Credentials (never exposed to users) ----
# These are YOUR accounts — users call through your keys

# OpenAI
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Perplexity
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# Apify (Google Maps scraper)
# Get from: https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_...

# DataForSEO
# Get from: https://app.dataforseo.com/api-dashboard
DATAFORSEO_LOGIN=your@email.com
DATAFORSEO_PASSWORD=your-password

# ---- Deployment -------------------------------------------
NEXT_PUBLIC_APP_URL=https://getkeyone.com   # public base URL, used in emails and agent hints
EMAIL_FROM="key.one <alerts@getkeyone.com>" # optional; domain must be verified in Resend
TOP_UP_MIN_USD=5                             # lower to 1 temporarily to verify live payments cheaply
CRON_SECRET=change-me                        # protects /api/controller/cron (Vercel Cron sends it as a Bearer token)
